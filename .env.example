# Postgres connection string. For local dev with Prisma's built-in local
# Postgres server, run `npx prisma dev` and it will print a
# prisma+postgres://localhost:... URL to use here.
DATABASE_URL="postgres://user:password@localhost:5432/portfolio"

# Secret used to sign admin session JWTs. Generate with:
#   openssl rand -base64 32
JWT_SECRET=""

# Admin login credentials.
ADMIN_EMAIL=""
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=""
